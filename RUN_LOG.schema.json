{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUN_LOG — โครงสร้างเท่านั้น ไม่มีตัวอย่างบันทึก",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "agentId",
    "startedAt",
    "status",
    "trigger",
    "parentAgentId",
    "steps"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^(?!demo-)[A-Za-z0-9_.:-]{1,128}$"
    },
    "agentId": {
      "type": "string",
      "pattern": "^(?!demo-)[A-Za-z0-9_.:-]{1,128}$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "success",
        "failed",
        "escalated",
        "abandoned"
      ]
    },
    "trigger": {
      "enum": [
        "user",
        "schedule",
        "agent"
      ]
    },
    "parentAgentId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!demo-)[A-Za-z0-9_.:-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "steps": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "skillId",
          "durationSec",
          "waitSec",
          "status",
          "retries"
        ],
        "properties": {
          "stage": {
            "enum": [
              "intake",
              "routing",
              "retrieval",
              "execution",
              "validation",
              "approval",
              "delivery"
            ]
          },
          "skillId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!demo-)[A-Za-z0-9_.:-]{1,128}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "durationSec": {
            "type": "number",
            "minimum": 0,
            "maximum": 31536000
          },
          "waitSec": {
            "type": "number",
            "minimum": 0,
            "maximum": 31536000
          },
          "status": {
            "enum": [
              "ok",
              "fail",
              "retry"
            ]
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    }
  }
}